# ---------------------------------------------------------------
# Firebase (frontend)
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ENABLE_CLOUD_ASSISTANT=true
VITE_CHECKOUT_API_URL=

# ---------------------------------------------------------------
# Asistente de IA
# ---------------------------------------------------------------
# Opción A (recomendada): proxy público. La clave queda solo en el servidor.
# En Android puedes usar HTTPS público o la IP LAN de tu PC con ai-server.cjs
# (ej. http://192.168.0.10:8787). La app permite HTTP local gracias a
# network_security_config.xml. Si dejas 127.0.0.1/localhost, Android usará
# automáticamente el modo directo de la Opción B.
VITE_AI_API_URL=
VITE_AI_TOKEN=

# Opción B: modo directo desde el dispositivo (sin servidor).
# La clave se incrusta en la app y puede ser extraída. Usa una clave
# de OpenRouter con límite de gasto bajo.
VITE_AI_DIRECT_KEY=
VITE_AI_MODELS=google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free,openrouter/auto

# ---------------------------------------------------------------
# Servidor proxy (ai-server.cjs) — variables privadas, nunca VITE_*
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free,openrouter/auto
AI_PROVIDER=openrouter
AI_SERVER_PORT=8787
AI_SERVER_HOST=0.0.0.0
AI_ALLOWED_ORIGINS=*
AI_SHARED_TOKEN=
AI_RATE_LIMIT_PER_MINUTE=30
AI_TIMEOUT_MS=60000
