<?xml version="1.0" encoding="utf-8"?>
<!--
  VITIMAX permite HTTP sin cifrar para poder usar el servidor de IA local
  (ai-server.cjs) desde la red WiFi, por ejemplo http://192.168.0.10:8787.
  Android 9+ bloquea HTTP por defecto; esta configuración lo habilita.
  Las conexiones HTTPS (OpenRouter, Firebase) siguen usando los certificados del sistema.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
